# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini            # generation model (swap for any current cheap OpenAI model)
JUDGE_MODEL=gpt-4o-mini          # RAGAS judge model
EMBED_MODEL=BAAI/bge-small-en-v1.5   # open-source, runs locally via FastEmbed

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=rag-sprints
